# ── Dev / environment (never commit real secrets) ────────────────────────────
# RPC endpoint of the local Hardhat node
RPC_URL=http://127.0.0.1:8545

# Hardhat dev accounts (safe — these ship with every Hardhat repo)
# #0 = owner (registers protocols/sites), #1 = issuer (adds members), #2 = relayer (submits enrollments)
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
RELAYER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Ports
ISSUER_PORT=4001
RELAYER_PORT=4002

# Location of the compiled + deployed artifacts
DEPLOYMENT_FILE=../contracts/deployments/localhost.json
ARTIFACT_FILE=../contracts/artifacts/contracts/TrialFence.sol/TrialFence.json

# ── Polygon Amoy (testnet, leave unset for local) ────────────────────────────
# DEPLOYER_PRIVATE_KEY=0x...
# RPC_URL=https://rpc-amoy.polygon.technology
# ISSUER_ADDRESS=0x...
# EXPLORER_URL=https://www.oklink.com/amoy

# ── Optional AI integrity monitor ────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Web (baked at build time; defaults point at the same-origin Next proxy) ──
# NEXT_PUBLIC_RELAYER_URL=/api/relayer
# NEXT_PUBLIC_ISSUER_URL=/api/issuer